# ==============================================================================
# SEBI-Compliant Algorithmic Trading System — Configuration
# ==============================================================================

# Application Environment (production | development)
APP_ENV=production

# Database Configuration (SQLite default / PostgreSQL cloud)
DATABASE_URL=sqlite:///./trading_system.db

# JWT Security Key (256-bit secret for workstation authentication)
JWT_SECRET_KEY=algo-trading-jwt-secret-key-sebi-v2-prod-secure-token

# TradingView Webhook Secret
TRADINGVIEW_WEBHOOK_SECRET=client-secure-webhook-secret-change-me

# Broker Credentials — Zerodha Kite Connect
KITE_API_KEY=your_kite_api_key
KITE_API_SECRET=your_kite_api_secret
KITE_USER_ID=your_kite_user_id
KITE_PASSWORD=your_kite_password
KITE_TOTP_SECRET=your_base32_totp_secret_key
KITE_ALGO_ID=SEBI_ALGO_001

# Broker Credentials — Angel One SmartAPI (Optional)
ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=
ANGEL_ALGO_ID=

# SEBI Risk Management Defaults (₹ INR)
TOTAL_CAPITAL=100000.00
RISK_PER_TRADE_PCT=1.0
MAX_DAILY_LOSS=1000.00
MAX_TRADES_PER_DAY=3
COOLDOWN_MINUTES_AFTER_LOSS=20

# Telegram Mobile Push Notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_personal_or_channel_chat_id

# Operating Mode (true: Paper Trading Demo, false: Live Broker Real Capital)
PAPER_TRADING_MODE=true